<?xml version="1.0"?>
<!--
  ProductPackage.dtsx
  A minimal SSIS package (SQL Server 2012+ project format, PackageFormatVersion 8).

  What it does (control flow, top to bottom):
    1. Create Product Table   - drops/creates dbo.Product
    2. Load Product Data      - inserts a few sample rows
    3. Count Loaded Products  - SELECT COUNT(*) into variable User::ProductCount

  Before running: edit the connection string in the "SampleDB" connection
  manager to point at a database you can write to.
-->
<DTS:Executable xmlns:DTS="www.microsoft.com/SqlServer/Dts"
  DTS:refId="Package"
  DTS:CreationDate="11/13/2026 00:00:00"
  DTS:CreationName="Microsoft.Package"
  DTS:DTSID="{3E8B1C42-7A9D-4F15-B2C6-5D0E9F1A2B37}"
  DTS:ExecutableType="Microsoft.Package"
  DTS:LocaleID="1033"
  DTS:ObjectName="ProductPackage"
  DTS:PackageType="5"
  DTS:VersionBuild="1"
  DTS:VersionGUID="{9C4D2E61-1F3A-4B87-A5D9-0E7F8A6B5C24}">
  <DTS:Property DTS:Name="PackageFormatVersion">8</DTS:Property>

  <!-- ===================== Connection Managers ===================== -->
  <DTS:ConnectionManagers>
    <DTS:ConnectionManager
      DTS:refId="Package.ConnectionManagers[SampleDB]"
      DTS:CreationName="OLEDB"
      DTS:DTSID="{7B2F4A90-C3D1-4E58-9A6B-1F2E3D4C5B6A}"
      DTS:ObjectName="SampleDB">
      <DTS:ObjectData>
        <DTS:ConnectionManager
          DTS:ConnectionString="Data Source=localhost;Initial Catalog=SampleDB;Provider=MSOLEDBSQL;Integrated Security=SSPI;Auto Translate=False;" />
      </DTS:ObjectData>
    </DTS:ConnectionManager>
  </DTS:ConnectionManagers>

  <!-- ===================== Variables ===================== -->
  <DTS:Variables>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{E5A1B2C3-D4E5-4F67-8A9B-C0D1E2F3A4B5}"
      DTS:IncludeInDebugDump="6789"
      DTS:Namespace="User"
      DTS:ObjectName="ProductCount">
      <DTS:VariableValue DTS:DataType="3">0</DTS:VariableValue>
    </DTS:Variable>
  </DTS:Variables>

  <!-- ===================== Control Flow Tasks ===================== -->
  <DTS:Executables>

    <!-- 1. Create product table -->
    <DTS:Executable
      DTS:refId="Package\Create Product Table"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{F1000001-0000-4000-8000-000000000011}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Create Product Table"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{7B2F4A90-C3D1-4E58-9A6B-1F2E3D4C5B6A}"
          SQLTask:SqlStatementSource="IF OBJECT_ID('dbo.Product','U') IS NOT NULL DROP TABLE dbo.Product;&#xA;CREATE TABLE dbo.Product (&#xA;  ProductID INT NOT NULL PRIMARY KEY,&#xA;  ProductName NVARCHAR(150) NOT NULL,&#xA;  Category NVARCHAR(50) NULL,&#xA;  UnitPrice DECIMAL(18,2) NOT NULL,&#xA;  StockQuantity INT NOT NULL DEFAULT 0,&#xA;  LoadDate DATETIME2 NOT NULL DEFAULT SYSDATETIME()&#xA;);"
          xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>

    <!-- 2. Load sample rows -->
    <DTS:Executable
      DTS:refId="Package\Load Product Data"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{F1000002-0000-4000-8000-000000000012}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Load Product Data"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{7B2F4A90-C3D1-4E58-9A6B-1F2E3D4C5B6A}"
          SQLTask:SqlStatementSource="INSERT INTO dbo.Product (ProductID, ProductName, Category, UnitPrice, StockQuantity)&#xA;VALUES (1, N'Laptop', N'Electronics', 65000.00, 50),&#xA;       (2, N'Keyboard', N'Accessories', 1500.00, 200),&#xA;       (3, N'Monitor', N'Electronics', 12000.00, 75),&#xA;       (4, N'Mouse', N'Accessories', 800.00, 150);"
          xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>

    <!-- 3. Count rows into a variable (single-row result set) -->
    <DTS:Executable
      DTS:refId="Package\Count Loaded Products"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{F1000003-0000-4000-8000-000000000013}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Count Loaded Products"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{7B2F4A90-C3D1-4E58-9A6B-1F2E3D4C5B6A}"
          SQLTask:SqlStatementSource="SELECT COUNT(*) AS ProductCnt FROM dbo.Product;"
          SQLTask:ResultType="ResultSetType_SingleRow"
          xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="ProductCnt"
            SQLTask:DtsVariableName="User::ProductCount" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>

  </DTS:Executables>

  <!-- ===================== Precedence Constraints (On Success) ===================== -->
  <DTS:PrecedenceConstraints>
    <DTS:PrecedenceConstraint
      DTS:refId="Package.PrecedenceConstraints[Constraint 1]"
      DTS:CreationName=""
      DTS:DTSID="{B3000001-0000-4000-8000-000000000021}"
      DTS:From="Package\Create Product Table"
      DTS:LogicalAnd="True"
      DTS:ObjectName="Constraint 1"
      DTS:To="Package\Load Product Data" />
    <DTS:PrecedenceConstraint
      DTS:refId="Package.PrecedenceConstraints[Constraint 2]"
      DTS:CreationName=""
      DTS:DTSID="{B3000002-0000-4000-8000-000000000022}"
      DTS:From="Package\Load Product Data"
      DTS:LogicalAnd="True"
      DTS:ObjectName="Constraint 2"
      DTS:To="Package\Count Loaded Products" />
  </DTS:PrecedenceConstraints>
</DTS:Executable>
