<?xml version='1.0' encoding='utf-8'?>
<DTS:Executable xmlns:DTS="www.microsoft.com/SqlServer/Dts" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" DTS:refId="Package" DTS:ObjectName="DailyLedgerLoad" DTS:ExecutableType="Microsoft.Package" DTS:CreationName="Microsoft.Package">
  <DTS:Property DTS:Name="PackageFormatVersion">8</DTS:Property>
  <DTS:ConnectionManagers>
    <DTS:ConnectionManager DTS:refId="Package.ConnectionManagers[DemoDB]" DTS:ObjectName="DemoDB" DTS:CreationName="OLEDB" DTS:DTSID="{77777777-7777-4777-8777-777777777777}">
      <DTS:ObjectData>
        <DTS:ConnectionManager DTS:ConnectionString="Data Source=localhost;Initial Catalog=CrosslakeDemo;Provider=MSOLEDBSQL;Integrated Security=SSPI;" />
      </DTS:ObjectData>
    </DTS:ConnectionManager>
  </DTS:ConnectionManagers>
  <DTS:Variables>
    <DTS:Variable DTS:Namespace="User" DTS:ObjectName="LedgerRowCount">
      <DTS:VariableValue DTS:DataType="3">0</DTS:VariableValue>
    </DTS:Variable>
  </DTS:Variables>
  <DTS:Executables>
    <DTS:Executable DTS:refId="Package\Create Ledger Table" DTS:ObjectName="Create Ledger Table" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:CreationName="Microsoft.ExecuteSQLTask">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{77777777-7777-4777-8777-777777777777}" SQLTask:SqlStatementSource="DROP TABLE IF EXISTS dbo.CrosslakeDemoLedger; CREATE TABLE dbo.CrosslakeDemoLedger (LedgerID INT NOT NULL, Amount DECIMAL(18,2) NOT NULL, BusinessDate DATE NOT NULL);" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\Load Ledger Rows" DTS:ObjectName="Load Ledger Rows" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:CreationName="Microsoft.ExecuteSQLTask">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{77777777-7777-4777-8777-777777777777}" SQLTask:SqlStatementSource="INSERT INTO dbo.CrosslakeDemoLedger VALUES (1,10.00,'2026-01-31'),(2,20.00,'2026-01-31'),(3,30.00,'2026-01-31'),(4,40.00,'2026-01-31');" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\Count Ledger Rows" DTS:ObjectName="Count Ledger Rows" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:CreationName="Microsoft.ExecuteSQLTask">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{77777777-7777-4777-8777-777777777777}" SQLTask:SqlStatementSource="SELECT COUNT(*) AS LedgerCnt FROM dbo.CrosslakeDemoLedger;" SQLTask:ResultType="ResultSetType_SingleRow">
          <SQLTask:ResultBinding SQLTask:ResultName="LedgerCnt" SQLTask:DtsVariableName="User::LedgerRowCount" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
  <DTS:PrecedenceConstraints>
    <DTS:PrecedenceConstraint DTS:From="Package\Create Ledger Table" DTS:To="Package\Load Ledger Rows" DTS:Value="0" DTS:LogicalAnd="True" />
    <DTS:PrecedenceConstraint DTS:From="Package\Load Ledger Rows" DTS:To="Package\Count Ledger Rows" DTS:Value="0" DTS:LogicalAnd="True" />
  </DTS:PrecedenceConstraints>
</DTS:Executable>