<?xml version='1.0' encoding='utf-8'?>
<DTS:Executable xmlns:DTS="www.microsoft.com/SqlServer/Dts" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" DTS:refId="Package" DTS:ObjectName="DailyLedgerSummary" DTS:ExecutableType="Microsoft.Package" DTS:CreationName="Microsoft.Package">
  <DTS:Property DTS:Name="PackageFormatVersion">8</DTS:Property>
  <DTS:ConnectionManagers>
    <DTS:ConnectionManager DTS:refId="Package.ConnectionManagers[DemoDB]" DTS:ObjectName="DemoDB" DTS:CreationName="OLEDB" DTS:DTSID="{77777777-7777-4777-8777-777777777777}">
      <DTS:ObjectData>
        <DTS:ConnectionManager DTS:ConnectionString="Data Source=localhost;Initial Catalog=CrosslakeDemo;Provider=MSOLEDBSQL;Integrated Security=SSPI;" />
      </DTS:ObjectData>
    </DTS:ConnectionManager>
  </DTS:ConnectionManagers>
  <DTS:Variables>
    <DTS:Variable DTS:Namespace="User" DTS:ObjectName="BusinessDate">
      <DTS:VariableValue DTS:DataType="8">2026-01-31</DTS:VariableValue>
    </DTS:Variable>
  </DTS:Variables>
  <DTS:Executables>
    <DTS:Executable DTS:refId="Package\Summarize Business Date" DTS:ObjectName="Summarize Business Date" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:CreationName="Microsoft.ExecuteSQLTask">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{77777777-7777-4777-8777-777777777777}" SQLTask:SqlStatementSource="SELECT BusinessDate, COUNT(*) AS LedgerCnt, SUM(Amount) AS TotalAmount FROM dbo.CrosslakeDemoLedger WHERE BusinessDate = ? GROUP BY BusinessDate;">
          <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::BusinessDate" SQLTask:ParameterDirection="Input" SQLTask:DataType="130" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\Count Ledger Rows" DTS:ObjectName="Count Ledger Rows" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:CreationName="Microsoft.ExecuteSQLTask">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{77777777-7777-4777-8777-777777777777}" SQLTask:SqlStatementSource="SELECT COUNT(*) AS LedgerCnt FROM dbo.CrosslakeDemoLedger;" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
  <DTS:PrecedenceConstraints>
    <DTS:PrecedenceConstraint DTS:From="Package\Summarize Business Date" DTS:To="Package\Count Ledger Rows" DTS:Value="0" DTS:LogicalAnd="True" />
  </DTS:PrecedenceConstraints>
</DTS:Executable>